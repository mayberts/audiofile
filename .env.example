# audiofile connects to a slskd instance you already run — configure its URL
# and API key from the app's Settings page after startup (with a Test
# Connection / Auto-detect button), not here.

# Required by MusicBrainz's API usage policy — put a real contact (email or app URL).
MUSICBRAINZ_CONTACT=you@example.com

# Host path where your existing slskd container writes completed downloads.
# Must match slskd's own downloads folder exactly — audiofile reads finished
# files from here, tags them, and moves them into HOST_LIBRARY_DIR.
HOST_DOWNLOADS_DIR=./data/downloads

# Host path where the final, tagged library should be written.
# Point this at wherever your Plex "Music" library section is rooted.
HOST_LIBRARY_DIR=./data/music
