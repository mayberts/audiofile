# Soulseek account credentials used by slskd to connect to the network.
SOULSEEK_USERNAME=your-soulseek-username
SOULSEEK_PASSWORD=your-soulseek-password

# Any random string — this locks down slskd's + audiofile's API.
SLSKD_API_KEY=change-me-to-a-random-string

# Optional: point at an existing Plex Media Server to enable library gap scanning.
# Get a token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_URL=http://your-plex-host:32400
PLEX_TOKEN=

# Required by MusicBrainz's API usage policy — put a real contact (email or app URL).
MUSICBRAINZ_CONTACT=you@example.com

# Host path where the final, tagged library should be written.
# Point this at wherever your Plex "Music" library section is rooted.
HOST_LIBRARY_DIR=./data/music
